---
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';
import { externalLinkProps } from '../utils/externalLink';

interface Props {
  title: string;
  href: string;
  buyUrl: string;
  desc?: string;
  buyLabel?: string;
  viewLabel?: string;
  class?: string;
}

const {
  title,
  href,
  buyUrl,
  desc,
  buyLabel = 'Get access',
  viewLabel = 'View details',
  class: className,
} = Astro.props;

const buyLink = externalLinkProps(buyUrl);
---

<Card class:list={['group flex h-full flex-col transition-shadow hover:shadow-md', className]}>
  <CardHeader class="space-y-2.5">
    <CardTitle class="text-lg normal-case leading-snug">
      <a href={href} class="hover:text-primary">{title}</a>
    </CardTitle>
  </CardHeader>
  {
    desc && (
      <CardContent class="flex-1">
        <p class="text-sm leading-relaxed text-muted-foreground">{desc}</p>
      </CardContent>
    )
  }
  <CardFooter class="mt-auto !flex !flex-col !items-stretch gap-2">
    <Button
      as="a"
      href={buyUrl}
      variant="primary"
      size="sm"
      class="w-full min-w-0 justify-center overflow-hidden"
      aria-label={buyLabel}
      {...buyLink}
    >
      <span class="min-w-0 flex-1 truncate text-left">{buyLabel}</span>
      <Icon name="arrowRight" size={17} class="shrink-0" />
    </Button>
    <Button
      as="a"
      href={href}
      variant="outline"
      size="sm"
      class="w-full min-w-0 justify-center overflow-hidden"
      aria-label={viewLabel}
    >
      <span class="min-w-0 flex-1 truncate text-left">{viewLabel}</span>
      <Icon name="arrowRight" size={17} class="shrink-0" />
    </Button>
  </CardFooter>
</Card>
