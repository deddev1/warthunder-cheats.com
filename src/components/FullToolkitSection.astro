---
import { t } from '../i18n';
import { fullToolkitIcons } from '../data/sectionIcons';
import Icon from './icons/Icon.astro';

const s = t.toolkit;
---

<section
  id="full-toolkit"
  class="full-toolkit border-y border-border bg-muted/20 py-16 md:py-24"
  aria-labelledby="full-toolkit-title"
>
  <div class="mx-auto max-w-6xl px-5 md:px-6">
    <header class="full-toolkit__header">
      <p class="full-toolkit__eyebrow">{s.eyebrow}</p>
      <div class="full-toolkit__intro">
        <h2 id="full-toolkit-title" class="full-toolkit__title">
          {s.title}
        </h2>
        <p class="full-toolkit__subtitle">{s.subtitle}</p>
      </div>
    </header>

    <div class="full-toolkit__grid">
      {
        s.categories.map((category) => (
          <article class="full-toolkit__card">
            <header class="full-toolkit__card-head">
              <span class="full-toolkit__card-icon" aria-hidden="true">
                <Icon
                  name={fullToolkitIcons[category.id] ?? 'crosshair'}
                  size={18}
                />
              </span>
              <h3 class="full-toolkit__card-title">{category.title}</h3>
            </header>
            <ul class="full-toolkit__list">
              {category.features.map((feature) => (
                <li class="full-toolkit__feature">
                  <p class="full-toolkit__feature-title">{feature.title}</p>
                  <p class="full-toolkit__feature-desc">{feature.desc}</p>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .full-toolkit__header {
    margin-bottom: 2.25rem;
  }

  .full-toolkit__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.15rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .full-toolkit__eyebrow::before {
    content: '';
    display: block;
    width: 1.75rem;
    height: 1px;
    background: var(--primary);
    flex-shrink: 0;
  }

  .full-toolkit__intro {
    display: grid;
    gap: 1rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .full-toolkit__header {
      margin-bottom: 2.75rem;
    }

    .full-toolkit__intro {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2.5rem;
      align-items: end;
    }
  }

  .full-toolkit__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .full-toolkit__subtitle {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  @media (min-width: 768px) {
    .full-toolkit__subtitle {
      text-align: right;
      max-width: 22rem;
      margin-left: auto;
      padding-bottom: 0.2rem;
    }
  }

  .full-toolkit__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .full-toolkit__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .full-toolkit__card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 1.35rem 1.35rem 0.85rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--card);
    box-shadow: 0 1px 2px color-mix(in oklch, var(--foreground) 4%, transparent);
    transition: border-color 0.2s ease;
  }

  .full-toolkit__card:hover {
    border-color: color-mix(in oklch, var(--primary) 35%, var(--border));
  }

  .full-toolkit__card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
    padding-bottom: 1rem;
  }

  .full-toolkit__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.65rem;
    background: color-mix(in oklch, var(--primary) 12%, transparent);
    color: var(--primary);
    flex-shrink: 0;
  }

  .full-toolkit__card-icon :global(svg) {
    color: inherit;
  }

  .full-toolkit__card-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--foreground);
  }

  .full-toolkit__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .full-toolkit__feature {
    padding: 1rem 0;
    border-top: 1px solid color-mix(in oklch, var(--border) 85%, transparent);
  }

  .full-toolkit__feature-title {
    margin: 0 0 0.35rem;
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1.35;
    color: var(--foreground);
  }

  .full-toolkit__feature-desc {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }
</style>
