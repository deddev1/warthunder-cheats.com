---
interface Props {
  src: string;
  poster: string;
  alt: string;
  class?: string;
}

const {
  src,
  poster,
  alt,
  class: className,
} = Astro.props;
---

<figure
  class:list={['hero-video', className]}
  data-hero-video
>
  <div class="hero-video__frame">
    <video
      class="hero-video__media"
      data-hero-video-el
      src={src}
      poster={poster}
      preload="metadata"
      playsinline
      muted
      controls={false}
      aria-label={alt}
    ></video>
    <p class="sr-only">{alt}</p>

    <button
      type="button"
      class="hero-video__center"
      data-hero-video-toggle
      aria-label="Play video"
    >
      <span class="hero-video__center-icon" data-icon="play" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
          <path d="M8 5.14v13.72L19 12 8 5.14z"></path>
        </svg>
      </span>
      <span class="hero-video__center-icon is-hidden" data-icon="pause" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
          <path d="M6 5h4v14H6V5zm8 0h4v14h-4V5z"></path>
        </svg>
      </span>
    </button>

    <div class="hero-video__controls" data-hero-video-controls>
      <label class="hero-video__seek-wrap">
        <span class="sr-only">Seek video</span>
        <input
          type="range"
          class="hero-video__seek"
          data-hero-video-seek
          min="0"
          max="1000"
          value="0"
          step="1"
          aria-label="Video progress"
        />
      </label>

      <span class="hero-video__time" data-hero-video-time aria-live="off">0:00 / 0:00</span>
    </div>
  </div>
  <figcaption class="sr-only">{alt}</figcaption>
</figure>

<style>
  .hero-video {
    margin: 0;
    width: 100%;
  }

  .hero-video__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 0.75rem;
    background: color-mix(in oklch, var(--muted) 40%, black);
  }

  .hero-video__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #0a0d10;
  }

  .hero-video__center {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: 2;
    display: inline-flex;
    width: 3.75rem;
    height: 3.75rem;
    align-items: center;
    justify-content: center;
    translate: -50% -50%;
    border: 1px solid color-mix(in oklch, white 28%, transparent);
    border-radius: 999px;
    background: color-mix(in oklch, black 55%, transparent);
    color: white;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      opacity 0.2s ease;
  }

  .hero-video__center:hover {
    transform: scale(1.06);
    background: color-mix(in oklch, var(--primary) 72%, black);
  }

  .hero-video__center:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 55%, transparent);
  }

  .hero-video.is-playing .hero-video__center {
    opacity: 0;
    pointer-events: none;
  }

  .hero-video__frame:hover .hero-video__center,
  .hero-video__center:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-video__center-icon.is-hidden {
    display: none;
  }

  .hero-video__controls {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.75rem 0.75rem;
    background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.72));
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .hero-video__frame:hover .hero-video__controls,
  .hero-video__frame:focus-within .hero-video__controls,
  .hero-video:not(.is-playing) .hero-video__controls {
    opacity: 1;
  }

  .hero-video__seek-wrap {
    display: flex;
    align-items: center;
    margin: 0;
  }

  .hero-video__seek {
    width: 100%;
    height: 0.35rem;
    appearance: none;
    cursor: pointer;
    border-radius: 999px;
    background: color-mix(in oklch, white 25%, transparent);
    accent-color: #6f00ff;
  }

  .hero-video__seek::-webkit-slider-thumb {
    appearance: none;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
    background: #6f00ff;
    border: 2px solid white;
  }

  .hero-video__time {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in oklch, white 88%, transparent);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .hero-video__time {
      font-size: 0.65rem;
    }
  }
</style>

<script>
  function formatTime(seconds: number) {
    if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${s.toString().padStart(2, '0')}`;
  }

  function initHeroVideo(root: HTMLElement) {
    const video = root.querySelector<HTMLVideoElement>('[data-hero-video-el]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');
    const seek = root.querySelector<HTMLInputElement>('[data-hero-video-seek]');
    const timeEl = root.querySelector<HTMLElement>('[data-hero-video-time]');
    const playIcon = toggle?.querySelector<HTMLElement>('[data-icon="play"]');
    const pauseIcon = toggle?.querySelector<HTMLElement>('[data-icon="pause"]');

    if (!video || !toggle || !seek || !timeEl) return;

    let seeking = false;
    video.muted = true;

    const syncPlayUi = () => {
      const playing = !video.paused && !video.ended;
      root.classList.toggle('is-playing', playing);
      playIcon?.classList.toggle('is-hidden', playing);
      pauseIcon?.classList.toggle('is-hidden', !playing);
      toggle.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
    };

    const syncTime = () => {
      if (!seeking && video.duration) {
        seek.value = String(Math.round((video.currentTime / video.duration) * 1000));
      }
      timeEl.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration || 0)}`;
    };

    toggle.addEventListener('click', async () => {
      if (video.paused || video.ended) {
        try {
          await video.play();
        } catch {
          /* autoplay policies / user gesture issues */
        }
      } else {
        video.pause();
      }
    });

    seek.addEventListener('pointerdown', () => {
      seeking = true;
    });
    seek.addEventListener('pointerup', () => {
      seeking = false;
    });
    seek.addEventListener('input', () => {
      if (!video.duration) return;
      video.currentTime = (Number(seek.value) / 1000) * video.duration;
      syncTime();
    });

    video.addEventListener('play', syncPlayUi);
    video.addEventListener('pause', syncPlayUi);
    video.addEventListener('ended', () => {
      video.currentTime = 0;
      syncPlayUi();
      syncTime();
    });
    video.addEventListener('timeupdate', syncTime);
    video.addEventListener('loadedmetadata', syncTime);

    syncPlayUi();
    syncTime();
  }

  document.querySelectorAll<HTMLElement>('[data-hero-video]').forEach(initHeroVideo);
</script>
