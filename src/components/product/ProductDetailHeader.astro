---
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { externalLinkProps } from '../../utils/externalLink';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const buyLink = externalLinkProps(product.buyUrl);
const kicker =
  product.slug === 'elite'
    ? 'FC 27 Cheats'
    : product.slug === 'hwid-spoofer'
      ? 'HWID Spoofer'
      : product.slug === 'ugc'
        ? 'UGC recovery'
        : product.tier ?? product.category ?? 'FC 27';
---

<header class="product-detail-header space-y-5">
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">{kicker}</p>
  <h1 class="max-w-xl text-3xl font-bold normal-case leading-[1.15] tracking-tight md:text-4xl">
    {product.title}
  </h1>
  <p class="max-w-xl text-base leading-relaxed text-muted-foreground md:text-lg">
    {product.subtitle || product.desc}
  </p>
  <div class="flex flex-wrap items-center gap-3">
    <Button as="a" href={product.buyUrl} variant="primary" class="rounded-full" {...buyLink}>
      Get access
      <Icon name="arrowRight" size={16} />
    </Button>
    <Button as="a" href="/blog/buy-guide/" variant="outline" class="rounded-full">
      How to buy
    </Button>
  </div>
</header>
