---
import type { ProductSlide } from '../data/products';
import ResponsiveImage from './ResponsiveImage.astro';
import { THUMB_IMAGE_WIDTHS } from '../utils/responsiveImage';
import { Badge } from '@/components/starwind/badge';
import Icon from './icons/Icon.astro';

interface Props {
  images: ProductSlide[];
  id?: string;
}

const { images, id = 'product-screenshots' } = Astro.props;
const hasThumbs = images.length > 1;
const first = images[0];
---

<div
  class:list={['product-gallery', !hasThumbs && 'product-gallery--single']}
  id={id}
  data-product-gallery
  data-gallery-count={images.length}
>
  <div class="product-gallery__stage relative min-w-0 overflow-hidden rounded-xl border border-border bg-muted/20">
    <div class="product-gallery__main overflow-hidden">
      {
        first && (
          <ResponsiveImage
            src={first.src}
            alt={first.alt}
            width={960}
            height={540}
            loading="eager"
            fetchPriority="high"
            sizes="(min-width: 1024px) 640px, 100vw"
            class="product-gallery__image aspect-video w-full object-cover"
          />
        )
      }
    </div>

    {
      hasThumbs && (
        <div class="product-gallery__nav" aria-hidden="false">
          <button
            type="button"
            class="product-gallery__nav-btn product-gallery__nav-btn--prev"
            data-gallery-prev
            aria-label="Previous screenshot"
          >
            <Icon name="chevronLeft" size={18} />
          </button>
          <button
            type="button"
            class="product-gallery__nav-btn product-gallery__nav-btn--next"
            data-gallery-next
            aria-label="Next screenshot"
          >
            <Icon name="chevronRight" size={18} />
          </button>
        </div>
      )
    }

    <div class="product-gallery__meta pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-gradient-to-t from-black/55 to-transparent px-3 pb-3 pt-10">
      <Badge tone="neutral" appearance="frosted" size="sm" class="shadow-sm">
        <span data-gallery-counter>1 / {images.length}</span>
      </Badge>
    </div>
  </div>

  {
    first && (
      <p class="product-gallery__caption mt-2 text-sm text-muted-foreground" data-gallery-caption>
        <strong class="text-foreground" data-gallery-caption-title>{first.caption}</strong>
        {first.captionDesc && (
          <span data-gallery-caption-desc>{` — ${first.captionDesc}`}</span>
        )}
      </p>
    )
  }

  {
    hasThumbs && (
      <div class="product-gallery__thumbs" role="tablist" aria-label="Product screenshots">
        {images.map((img, i) => (
          <button
            type="button"
            class:list={['product-gallery__thumb', i === 0 && 'is-active']}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Screenshot ${i + 1}: ${img.caption}`}
            data-product-gallery-thumb
            data-index={i}
            data-src={img.src}
            data-alt={img.alt}
            data-caption={img.caption}
            data-caption-desc={img.captionDesc ?? ''}
          >
            <ResponsiveImage
              src={img.src}
              alt={img.alt}
              width={320}
              height={180}
              widths={THUMB_IMAGE_WIDTHS}
              loading="lazy"
              sizes="148px"
              class="size-full object-cover"
            />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  const initProductGalleries = () => {
    document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((root) => {
      if (root.hasAttribute('data-gallery-bound')) return;
      root.setAttribute('data-gallery-bound', '');

      const main = root.querySelector<HTMLImageElement>('.product-gallery__image');
      const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-product-gallery-thumb]')];
      const counter = root.querySelector('[data-gallery-counter]');
      const captionTitle = root.querySelector('[data-gallery-caption-title]');
      const captionDesc = root.querySelector('[data-gallery-caption-desc]');
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-gallery-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
      if (!main || !thumbs.length) return;

      let index = 0;

      const show = (nextIndex: number) => {
        index = (nextIndex + thumbs.length) % thumbs.length;
        const thumb = thumbs[index];
        if (!thumb) return;

        const thumbImg = thumb.querySelector('img');
        if (thumbImg?.src) {
          main.src = thumbImg.src;
          if (thumbImg.srcset) main.srcset = thumbImg.srcset;
        }
        const alt = thumb.getAttribute('data-alt');
        if (alt) main.alt = alt;

        const caption = thumb.getAttribute('data-caption') ?? '';
        const desc = thumb.getAttribute('data-caption-desc') ?? '';
        if (captionTitle) captionTitle.textContent = caption;
        if (captionDesc) captionDesc.textContent = desc ? ` — ${desc}` : '';
        if (counter) counter.textContent = `${index + 1} / ${thumbs.length}`;

        thumbs.forEach((t, i) => {
          const active = i === index;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        thumb.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      };

      thumbs.forEach((thumb, i) => {
        thumb.addEventListener('click', () => show(i));
      });
      prevBtn?.addEventListener('click', () => show(index - 1));
      nextBtn?.addEventListener('click', () => show(index + 1));

      root.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(index - 1);
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(index + 1);
        }
      });
    });
  };

  initProductGalleries();
  document.addEventListener('astro:after-swap', initProductGalleries);
</script>
