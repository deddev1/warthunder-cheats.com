---
import type { ProductSlide } from '../data/products';
import ImageSlider from './ImageSlider.astro';

interface Props {
  images: ProductSlide[];
  id?: string;
}

const { images, id = 'product-screenshots' } = Astro.props;
---

<div class="product-shots" id={`${id}-wrap`}>
  <ImageSlider
    id={id}
    images={images.map((img) => ({
      src: img.src,
      alt: img.alt,
      caption: img.caption,
      captionDesc: img.captionDesc ?? '',
    }))}
  />
</div>
