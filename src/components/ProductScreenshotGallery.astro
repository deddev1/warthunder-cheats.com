---
import type { ProductSlide } from '../data/products';
import ResponsiveImage from './ResponsiveImage.astro';
import { THUMB_IMAGE_WIDTHS } from '../utils/responsiveImage';
import { Badge } from '@/components/starwind/badge';

interface Props {
  images: ProductSlide[];
  id?: string;
}

const { images, id = 'product-screenshots' } = Astro.props;
const hasThumbs = images.length > 1;
const first = images[0];
---

<div
  class:list={['product-gallery', !hasThumbs && 'product-gallery--single']}
  id={id}
  data-product-gallery
>
  <div class="relative min-w-0 overflow-hidden rounded-xl border border-border bg-muted/20">
    <div class="product-gallery__main cursor-zoom-in overflow-hidden">
      {
        first && (
          <ResponsiveImage
            src={first.src}
            alt={first.alt}
            width={960}
            height={540}
            loading="eager"
            fetchPriority="high"
            sizes="(min-width: 1024px) 640px, 100vw"
            class="product-gallery__image aspect-video w-full object-cover"
          />
        )
      }
    </div>
    <Badge
      tone="neutral"
      appearance="frosted"
      size="sm"
      class="pointer-events-none absolute bottom-3 left-3 shadow-sm"
    >
      Delta Force cheats gameplay
    </Badge>
  </div>
  {
    first && (first.caption || first.captionDesc) && (
      <p class="mt-2 text-sm text-muted-foreground" data-product-gallery-caption>
        <strong class="text-foreground" data-product-gallery-caption-title>{first.caption}</strong>
        <span data-product-gallery-caption-desc>{first.captionDesc ? ` — ${first.captionDesc}` : ''}</span>
      </p>
    )
  }

  {
    hasThumbs && (
      <div class="product-gallery__thumbs" role="tablist" aria-label="Product screenshots">
        {images.map((img, i) => (
          <button
            type="button"
            class:list={['product-gallery__thumb', i === 0 && 'is-active']}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={img.caption || `Screenshot ${i + 1}`}
            data-product-gallery-thumb
            data-index={i}
            data-src={img.src}
            data-alt={img.alt}
            data-caption={img.caption}
            data-caption-desc={img.captionDesc}
          >
            <ResponsiveImage
              src={img.src}
              alt={img.alt}
              width={320}
              height={180}
              widths={THUMB_IMAGE_WIDTHS}
              loading="lazy"
              sizes="148px"
              class="size-full object-cover"
            />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  const initProductGalleries = () => {
    document.querySelectorAll('[data-product-gallery]').forEach((root) => {
      if (root.hasAttribute('data-gallery-bound')) return;
      root.setAttribute('data-gallery-bound', '');

      const main = root.querySelector<HTMLImageElement>('.product-gallery__image');
      const mainSource = root.querySelector<HTMLSourceElement>('.product-gallery__main source');
      const captionTitle = root.querySelector<HTMLElement>('[data-product-gallery-caption-title]');
      const captionDesc = root.querySelector<HTMLElement>('[data-product-gallery-caption-desc]');
      const thumbs = root.querySelectorAll<HTMLButtonElement>('[data-product-gallery-thumb]');
      if (!main || !thumbs.length) return;

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const alt = thumb.getAttribute('data-alt') ?? '';
          const caption = thumb.getAttribute('data-caption') ?? '';
          const desc = thumb.getAttribute('data-caption-desc') ?? '';
          const thumbImg = thumb.querySelector('img');
          const thumbSource = thumb.querySelector('source');

          if (thumbImg?.currentSrc || thumbImg?.src) {
            main.src = thumbImg.currentSrc || thumbImg.src;
            if (thumbImg.srcset) main.srcset = thumbImg.srcset;
          }
          if (thumbSource?.srcset && mainSource) {
            mainSource.srcset = thumbSource.srcset;
          }
          if (alt) main.alt = alt;
          if (captionTitle) captionTitle.textContent = caption;
          if (captionDesc) captionDesc.textContent = desc ? ` — ${desc}` : '';

          thumbs.forEach((t) => {
            const active = t === thumb;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
        });
      });
    });
  };

  initProductGalleries();
  document.addEventListener('astro:after-swap', initProductGalleries);
</script>
