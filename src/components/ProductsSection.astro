---
import '../styles/product-cheat-page.css';
import { t } from '../i18n';
import { catalogProducts } from '../data/products';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
import { productPath } from '../utils/path';
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from '@/components/starwind/carousel';

const s = t.products;

/** Short CTA labels that fit narrow carousel cards without overflow. */
function actionName(product: (typeof catalogProducts)[number]) {
  if (product.slug === 'elite') return 'Cheats';
  if (product.slug === 'hwid-spoofer') return 'HWID';
  if (product.slug === 'ugc') return 'UGC';
  return product.category ?? product.slug;
}
---

<section id="products" class="py-16 md:py-24" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="products-title" headingLevel="h2" />

    <div class="products-carousel" data-products-carousel>
      <Carousel
        autoInit
        opts={{ align: 'start', containScroll: 'trimSnaps', dragFree: false }}
        class="products-carousel__root"
      >
        <div class="products-carousel__stage">
          <CarouselPrevious class="products-carousel__arrow products-carousel__arrow--prev" hidden />
          <CarouselNext class="products-carousel__arrow products-carousel__arrow--next is-visible" />
          <div class="products-carousel__viewport">
            <CarouselContent class="products-carousel__track">
              {
                catalogProducts.map((product) => (
                  <CarouselItem class="products-carousel__slide">
                    <CatalogCard
                      class="catalog-card--carousel"
                      title={product.title}
                      href={productPath(product.slug)}
                      buyUrl={product.buyUrl}
                      desc={product.desc}
                      buyLabel={`Checkout ${actionName(product)}`}
                      viewLabel="View details"
                    />
                  </CarouselItem>
                ))
              }
            </CarouselContent>
          </div>
        </div>
      </Carousel>
    </div>
  </div>
</section>

<script>
  import { setupProductsCarousel } from '../scripts/products-carousel.ts';
  setupProductsCarousel();
</script>
