---
import { canonicalUrl } from '../config/seo';

interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
const pageUrl = canonicalUrl(Astro.url.pathname);
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(title ?? pageUrl);
const xHref = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const telegramHref = `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
---

<nav
  class:list={['social-share mt-8 text-sm text-muted-foreground', className]}
  aria-label="Share this page"
>
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Share</p>
  <ul class="flex flex-wrap gap-x-4 gap-y-2">
    <li>
      <a href={xHref} rel="noopener noreferrer" target="_blank">Share on X</a>
    </li>
    <li>
      <a href={facebookHref} rel="noopener noreferrer" target="_blank">Share on Facebook</a>
    </li>
    <li>
      <a href={telegramHref} rel="noopener noreferrer" target="_blank">Share on Telegram</a>
    </li>
  </ul>
</nav>
