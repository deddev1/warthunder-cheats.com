---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { ROUTES } from '../utils/path';
import SeoRelatedLinks from './SeoRelatedLinks.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbLabel: string;
  sections: { heading: string; paragraphs: string[] }[];
}

const { title, description, breadcrumbLabel, sections } = Astro.props;
---

<article class="py-8 md:py-12">
  <div class="mx-auto max-w-3xl px-5">
    <div class="text-left">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: breadcrumbLabel, path: Astro.url.pathname },
      ]}
    />
    </div>
    <header class="mt-4 space-y-4 text-center">
      <h1 class="text-3xl font-bold normal-case md:text-4xl">{title}</h1>
      <p class="text-lg leading-relaxed text-muted-foreground">{description}</p>
    </header>

    <Prose class="mt-10 max-w-none text-left">
      {sections.map((section) => (
        <section class="mt-8">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
    </Prose>

    <SeoRelatedLinks
      title="More FC27 Cheats pages"
      links={[
        { href: '/products/fc27-cheats/', label: 'Browse Lite Pro Elite catalog' },
        { href: '/blog/', label: 'Open buy guides archive' },
        { href: '/faq/', label: 'Read pre-purchase FAQ answers' },
        { href: '/reviews/', label: 'Read buyer feedback' },
        { href: '/forum/', label: 'Visit buyer forum discussions' },
        { href: '/support/', label: 'Start a Discord help ticket' },
        { href: '/privacy/', label: 'View privacy policy details' },
        { href: '/terms/', label: 'View terms and conditions' },
      ]}
    />

    <div class="mt-12 flex flex-wrap justify-center gap-3 border-t border-border pt-8">
      <Button as="a" href={ROUTES.support} variant="primary" size="sm">
        Open Discord support desk
        <Icon name="mail" size={16} />
      </Button>
      <Button as="a" href={ROUTES.home} variant="outline" size="sm">Return to store homepage</Button>
    </div>
  </div>
</article>
