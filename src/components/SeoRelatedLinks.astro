---
import { ROUTES } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { externalLinkProps } from '../utils/externalLink';
import { Button } from '@/components/starwind/button';

interface LinkItem {
  href: string;
  label: string;
}

interface Props {
  title?: string;
  links?: LinkItem[];
}

const defaultLinks: LinkItem[] = [
  { href: ROUTES.products, label: 'Open products hub for all tiers' },
  { href: '/products/deltaforce-cheats/elite/', label: 'Purchase Elite combat suite' },
  { href: '/products/deltaforce-cheats/utilities/', label: 'HWID UGC unlock utility table' },
  { href: ROUTES.blog, label: 'Read checkout and tier guides' },
  { href: ROUTES.faq, label: 'Open buying FAQ answers' },
  { href: ROUTES.reviews, label: 'See product review scores' },
  { href: '/about/', label: 'About the Delta Force Cheats store' },
  { href: '/forum/', label: 'Browse buyer forum threads' },
  { href: '/support/', label: 'Open Discord support tickets' },
  { href: '/privacy/', label: 'Read the privacy policy' },
];

const { title = 'Shop Delta Force cheats & guides', links = defaultLinks } = Astro.props;
const checkout = checkoutPath('deltaforce');
const checkoutAttrs = externalLinkProps(checkout);
---

<aside class="mt-12 rounded-xl border border-border bg-muted/20 p-6" aria-labelledby="seo-related-links-title">
  <p id="seo-related-links-title" class="text-lg font-semibold normal-case text-foreground">{title}</p>
  <ul class="mt-4 grid gap-2 sm:grid-cols-2">
    {links.map((item) => (
      <li>
        <a href={item.href} class="text-sm text-primary hover:underline">{item.label}</a>
      </li>
    ))}
  </ul>
  <div class="mt-6">
    <Button as="a" href={checkout} variant="primary" size="sm" {...checkoutAttrs}>Go to secure checkout</Button>
  </div>
</aside>
