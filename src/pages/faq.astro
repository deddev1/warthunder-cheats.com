---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SeoRelatedLinks from '../components/SeoRelatedLinks.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];

const faqs = getAllFaqs();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader
          eyebrow="FC 27 help center"
          title="FC 27 Cheats FAQ — Buy, Setup & Ban Risk"
          desc="This FAQ answers common pre-purchase questions—tiers, checkout, ban risk, Windows setup and HWID tools—in one place."
          titleId="faq-page-title"
        />
      </div>
      <p class="mt-5 text-sm leading-relaxed text-muted-foreground">
        Use this FAQ before checkout: each answer below covers delivery, supported platforms, tier differences and EA ban risk in plain language.
      </p>
    </div>
  </section>

  <SiteFaqSection items={faqs} variant="full" titleId="faq-page-list" contentAlign="left" />
  <div class="mx-auto max-w-3xl px-5 pb-16">
    <SeoRelatedLinks
      title="Related FC 27 cheat pages"
      links={[
        { href: '/products/fc27-cheats/', label: 'Compare Lite Pro Elite on products hub' },
        { href: '/products/fc27-cheats/elite/', label: 'Open Elite suite product page' },
        { href: '/blog/buy-guide/', label: 'Read the 2026 checkout buy guide' },
        { href: '/blog/lite-vs-pro/', label: 'See Lite vs Pro tier decision guide' },
        { href: '/reviews/', label: 'Browse buyer feedback' },
        { href: '/support/', label: 'Contact Discord support tickets' },
        { href: '/about/', label: 'Learn about the cheats storefront' },
        { href: '/forum/', label: 'Join FC 27 buyer forum threads' },
      ]}
    />
  </div>
</BaseLayout>
