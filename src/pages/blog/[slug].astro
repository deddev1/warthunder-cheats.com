---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getAllBlogSlugs, getBlogPost, getRelatedBlogPosts } from '../../data/blog';
import { pageTitle } from '../../config/seo';
import {
  articleSchema,
  breadcrumbSchema,
  faqPageSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/checkout';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../data/faq';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { blogPostPath, normalizeInternalPath, ROUTES } from '../../utils/path';
import { STATUS_VERIFIED_ISO } from '../../config/status';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog guides', path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      const normalized = normalizeInternalPath(href);
      return `<a href="${normalized}">${label}</a>`;
    })
    .replace(/(https:\/\/(?:fc27-cheats\.com|rust-cheats\.net)[^\s.,;)]*)/g, (_match, url: string) => {
      const path = url.replace(/^https:\/\/(?:fc27-cheats\.com|rust-cheats\.net)/, '');
      const normalized = normalizeInternalPath(path);
      const href = normalized.startsWith('http') ? normalized : `https://fc27-cheats.net${normalized}`;
      return `<a href="${href}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const modified =
  Date.parse(STATUS_VERIFIED_ISO) > Date.parse(published) ? STATUS_VERIFIED_ISO : published;
const blogFaqs = getBlogFaqs(post.tag, post.slug);
---

<BaseLayout
  title={post.seoTitle ?? pageTitle(post.title)}
  description={post.desc}
  ogType="article"
  ogImage={post.image}
  ogImageAlt={post.imageAlt ?? post.title}
  ogImageWidth={960}
  ogImageHeight={540}
  articlePublishedTime={published}
  articleModifiedTime={modified}
  jsonLd={[
    articleSchema({
      name: post.title,
      description: post.desc,
      url: postPath,
      image: post.image,
      datePublished: published,
      dateModified: modified,
    }),
    breadcrumbSchema(breadcrumbs),
    ...(blogFaqs.length > 0 ? [faqPageSchema(blogFaqs, { limit: 8 })] : []),
  ]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <BlogPostTopBar post={post} class="mt-6" />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <BlogSidebar post={post} related={related} class="order-2 lg:order-1" />

        <div class="order-1 min-w-0 lg:order-2">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={post.imageAlt ?? `${post.title} — FC 27 cheats ESP and aimbot gameplay screenshot`}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
            <figcaption class="sr-only">
              {post.imageAlt ?? `FC 27 cheats gameplay screenshot for ${post.title}. Shop Lite, Pro or Elite at fc27-cheats.net.`}
            </figcaption>
          </figure>

          <header class="blog-article__header">
            <h1 class="blog-article__title">{post.title}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={resolveCheckoutHref(block.href)}
                  />
                );
              }
              if (block.type === 'image') {
                return (
                  <figure class="blog-article__inline-shot not-prose my-6 overflow-hidden rounded-xl border border-border">
                    <ResponsiveImage
                      src={block.src}
                      alt={block.alt}
                      width={960}
                      height={540}
                      loading="lazy"
                      sizes="(min-width: 768px) 720px, 100vw"
                      class="w-full object-cover"
                    />
                    {block.caption ? (
                      <figcaption class="px-3 py-2 text-sm text-muted-foreground">{block.caption}</figcaption>
                    ) : (
                      <figcaption class="sr-only">{block.alt}</figcaption>
                    )}
                  </figure>
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={checkoutPath('fc27')} variant="primary" aria-label={t.ui.checkoutAria}>
              Finish article checkout
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={ROUTES.products} variant="outline">
              Browse products hub
            </Button>
            <Button as="a" href={blogPostPath('buy-guide')} variant="outline">
              How to buy guide
            </Button>
            <Button as="a" href={ROUTES.blog} variant="outline">
              More cheat guides
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={blogFaqs}
    titleId={`blog-faq-${post.slug}`}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
