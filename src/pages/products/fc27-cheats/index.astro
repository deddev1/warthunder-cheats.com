---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { catalogProducts, productHub } from '../../../data/products';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import FullToolkitSection from '../../../components/FullToolkitSection.astro';
import { productPath, ROUTES } from '../../../utils/path';
import { Prose } from '@/components/starwind/prose';
import SeoRelatedLinks from '../../../components/SeoRelatedLinks.astro';

const seo = resolvePageSeo('/products/fc27-cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

function actionName(product: (typeof catalogProducts)[number]) {
  if (product.slug === 'elite') return 'Cheats';
  if (product.slug === 'hwid-spoofer') return 'HWID';
  if (product.slug === 'ugc') return 'UGC';
  return product.category ?? product.slug;
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      catalogProducts.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold normal-case md:text-4xl">{t.products.title}</h1>
        <p class="text-lg text-muted-foreground">{t.products.subtitle}</p>
      </div>

      <Prose class="mt-8 max-w-none text-muted-foreground">
        <h2>Pick the product that matches your goal</h2>
        <p>
          FC 27 Cheats covers player ESP, soft aim, shot assist and Ultimate Team helpers. HWID Spoofer is for hardware
          flags after an EA ban. UGC organizes account appeal workflows. Read the{' '}
          <a href="/blog/buy-guide/">checkout walkthrough</a> or <a href={ROUTES.faq}>FAQ</a> if you need setup help.
        </p>
      </Prose>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {catalogProducts.map((product) => (
          <CatalogCard
            title={product.title}
            href={productPath(product.slug)}
            buyUrl={product.buyUrl}
            desc={product.desc}
            buyLabel={`Checkout ${actionName(product)}`}
            viewLabel="View details"
          />
        ))}
      </div>
    </div>
  </section>

  <FullToolkitSection />

  <div class="mx-auto max-w-6xl px-5 pb-16">
    <SeoRelatedLinks title="More FC 27 cheat resources" />
  </div>
</BaseLayout>
