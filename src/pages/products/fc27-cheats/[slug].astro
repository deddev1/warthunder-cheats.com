---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getAllProductSlugs,
  getProductPage,
  isCatalogProductSlug,
  productHub,
} from '../../../data/products';
import { pageTitle } from '../../../config/seo';
import { getPageSeoEntry } from '../../../config/pageSeo';
import { breadcrumbSchema, faqPageSchema, productSchema } from '../../../utils/schema';
import { getProductFaqs } from '../../../data/faq';
import { getProductFromPriceUsd } from '../../../data/productPricing';
import ProductDetail from '../../../components/ProductDetail.astro';

export function getStaticPaths() {
  return getAllProductSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = getProductPage(slug!);

if (!product) {
  return Astro.redirect(productHub.path);
}

const pagePath = `${productHub.path}${product.slug}/`;
const seoEntry = getPageSeoEntry(pagePath);
const metaTitle = seoEntry?.title ?? pageTitle(product.title);
const metaDescription = seoEntry?.description ?? product.desc;
const inCatalog = isCatalogProductSlug(product.slug);
const productFaqs = inCatalog ? getProductFaqs(product.slug, product.kind) : [];
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
  { name: product.title, path: pagePath },
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  noindex={!inCatalog}
  ogImage={product.images[0]?.src}
  ogImageAlt={product.images[0]?.alt ?? product.title}
  ogImageWidth={960}
  ogImageHeight={540}
  jsonLd={
    inCatalog
      ? [
          productSchema({
            name: product.title,
            description: product.desc,
            url: pagePath,
            offerUrl: product.buyUrl,
            image: product.images[0]?.src,
            sku: product.slug,
            priceUsd: getProductFromPriceUsd(product.slug),
          }),
          breadcrumbSchema(breadcrumbs),
          ...(productFaqs.length > 0 ? [faqPageSchema(productFaqs, { limit: 8 })] : []),
        ]
      : [breadcrumbSchema(breadcrumbs)]
  }
>
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
